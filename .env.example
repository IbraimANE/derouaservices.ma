# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Heberjahiz FTP Deployment (Optional - for automated cPanel deployment)
# NEVER commit your real credentials to Git or public repositories!
HEBERJAHIZ_FTP_HOST="159.8.122.136"
HEBERJAHIZ_FTP_PORT="21"
HEBERJAHIZ_FTP_USER="your_cpanel_username"
HEBERJAHIZ_FTP_PASS="your_secure_ftp_password"
HEBERJAHIZ_TARGET_DIR="public_html"

# Google Maps Platform API Key (Required for interactive maps)
VITE_GOOGLE_MAPS_API_KEY=

